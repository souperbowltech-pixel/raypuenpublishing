# ============================================================================
#  PUEN PUBLISHING — ENVIRONMENT VARIABLES
# ============================================================================
#  Copy this file to `.env.local` and fill in real values.
#
#  NOTHING in this file is used in Milestone 1. Every variable below is
#  documented now so that Milestone 2 (payments, print fulfilment, email)
#  can be wired up without guessing what is needed. Leave them blank for now.
#
#  NOTE: variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
#        Everything else is server-only and must never be committed.
# ============================================================================

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public base URL of the deployed site (used for redirects / absolute links).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Stripe — retail & wholesale payments (Milestone 2)
# ---------------------------------------------------------------------------
# Publishable key (safe for the browser).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Secret key (server only — NEVER expose to the browser).
STRIPE_SECRET_KEY=""
# Signing secret for verifying Stripe webhook events.
STRIPE_WEBHOOK_SECRET=""
# Price ID for the retail coloring book (created in the Stripe dashboard).
STRIPE_PRICE_ID_RETAIL=""

# ---------------------------------------------------------------------------
# IngramSpark — print-on-demand fulfilment (pending API access from client)
# ---------------------------------------------------------------------------
# Not used yet. Add IngramSpark API credentials here once provided.

# ---------------------------------------------------------------------------
# MailerLite — email / newsletter (Milestone 2)
# ---------------------------------------------------------------------------
MAILERLITE_API_KEY=""
# Group/segment IDs to add retail buyers and institutional contacts to.
MAILERLITE_RETAIL_GROUP_ID=""
MAILERLITE_INSTITUTION_GROUP_ID=""

# ---------------------------------------------------------------------------
# Supabase — scout gamification store
# ---------------------------------------------------------------------------
# Project URL (server-side preferred). NEXT_PUBLIC_ variant may be set too but
# the server reads SUPABASE_URL first.
SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_URL=""
# Service-role key — SERVER ONLY. Bypasses RLS; used by all API routes for
# reads/writes. NEVER prefix this with NEXT_PUBLIC_ and never expose it to the
# browser.
SUPABASE_SERVICE_ROLE_KEY=""
# Public anon key (safe for the browser). With the hardened RLS (see
# supabase_schema.sql) the anon key is default-deny and cannot read/write rows.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# Failure alerts
# ---------------------------------------------------------------------------
# Optional Slack-compatible incoming-webhook URL. Failed order processing
# (order not saved, Book 3 unlock failed, MailerLite sync failed) posts here.
ALERT_WEBHOOK_URL=""

# ---------------------------------------------------------------------------
# Gamification / demo flags
# ---------------------------------------------------------------------------
# Set to "true" ONLY in local/demo environments to allow the dashboard's
# "Simulate Friend Join" button to self-award the 300 referral points.
# Leave blank/false in production so the 700-point Volume 3 unlock cannot be
# self-awarded without a real referral.
ALLOW_DEMO_REFERRAL=""
